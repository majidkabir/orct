{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/majidkabir/orct/schema/orct-statement-0.2.schema.json",
 "title": "ORCT 0.2 charge statement",
 "type": "object",
 "properties": {
  "orct_statement": {
   "const": "0.2"
  },
  "complete": {
   "type": "boolean"
  },
  "lines": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "dataset": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
     },
     "charge": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
     },
     "component": {
      "enum": [
       "infrastructure",
       "air_pollution",
       "noise",
       "air_pollution_noise",
       "co2",
       "congestion",
       "markup",
       "access",
       "carbon_price",
       "unspecified",
       "other"
      ]
     },
     "objects": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1,
       "pattern": "^\\S(.*\\S)?$"
      }
     },
     "row": {
      "type": "integer",
      "minimum": 0
     },
     "quantity": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
     },
     "unit": {
      "type": "string"
     },
     "rate": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
     },
     "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
     },
     "currency": {
      "type": "string"
     },
     "tax_basis": {
      "enum": [
       "included",
       "excluded",
       "not_applicable",
       "unknown"
      ]
     },
     "tax_rate": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
     },
     "sources": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1,
       "pattern": "^\\S(.*\\S)?$"
      }
     },
     "notes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "additionalProperties": false,
    "required": [
     "dataset",
     "charge",
     "component",
     "objects",
     "quantity",
     "unit",
     "amount",
     "currency",
     "tax_basis"
    ]
   }
  },
  "totals": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "currency": {
      "type": "string"
     },
     "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
     }
    },
    "additionalProperties": false,
    "required": [
     "currency",
     "amount"
    ]
   }
  },
  "issues": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "dataset": {
      "type": "string"
     },
     "charge": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "code",
     "message"
    ]
   }
  }
 },
 "additionalProperties": false,
 "required": [
  "orct_statement",
  "complete",
  "lines",
  "totals",
  "issues"
 ]
}