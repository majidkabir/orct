      "free"
     ]
    },
    "time_basis": {
     "enum": [
      "entry",
      "exit",
      "event"
     ]
    },
    "rounding": {
     "type": "object",
     "properties": {
      "increment": {
       "type": "string",
       "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
      },
      "mode": {
       "enum": [
