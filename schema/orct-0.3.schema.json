{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://raw.githubusercontent.com/majidkabir/orct/main/schema/orct-0.3.schema.json",
 "title": "ORCT 0.3 dataset",
 "type": "object",
 "properties": {
  "orct": {
   "const": "0.3"
  },
  "dataset": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^\\S(.*\\S)?$"
    },
    "version": {
     "type": "string"
    },
    "scheme": {
     "type": "object",
     "properties": {
      "id": {
       "type": "string",
       "minLength": 1,
       "pattern": "^\\S(.*\\S)?$"
      },
      "name": {
       "type": "string"
      },
      "country": {
       "type": "string",
       "pattern": "^[A-Z]{2}$"
      },
      "region": {
       "type": "string",
       "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
      }
     },
     "additionalProperties": false,
     "required": [
      "id",
      "name",
      "country"
     ]
    },
    "toll_charger": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string"
      },
      "country": {
       "type": "string",
       "pattern": "^[A-Z]{2}$"
      },
      "url": {
       "type": "string"
      },
      "efc_provider": {
       "type": "object",
       "properties": {
        "country_code": {
         "type": "string"
        },
        "issuer_id": {
         "type": "integer"
        }
       },
       "additionalProperties": false,
       "required": [
        "country_code",
        "issuer_id"
       ]
      }
     },
     "additionalProperties": false,
     "required": [
      "name"
     ]
    },
    "publisher": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string"
      },
      "role": {
       "enum": [
        "toll_charger",
        "authority",
        "third_party"
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "additionalProperties": false,
     "required": [
      "name",
      "role"
     ]
    },
    "valid_from": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "valid_to": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "currency": {
     "type": "string",
     "pattern": "^[A-Z]{3}$"
    },
    "timezone": {
     "type": "string",
     "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$"
    },
    "license": {
     "type": "string"
    },
    "method": {
     "type": "string"
    },
    "names": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "derived_from": {
     "type": "object",
     "properties": {
      "url": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "commit": {
       "type": "string"
      }
     },
     "additionalProperties": false,
     "required": [
      "url"
     ]
    },
    "efc_context": {
     "type": "object",
     "properties": {
      "standard": {
       "enum": [
        "ISO 17575-3",
        "EN 16986",
        "ISO 12855"
       ]
      },
      "version": {
       "type": "string"
      },
      "valid_from": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
     },
     "additionalProperties": false,
     "required": [
      "standard",
      "version"
     ]
    },
    "required_features": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "type.distance",
       "type.section",
       "type.od",
       "type.point",
       "type.area",
       "type.period",
       "type.quantity",
       "time_classes",
       "calendars",
       "user_classes",
       "rounding",
       "volume",
       "dynamic",
       "rule.exemption",
       "rule.included_in",
       "rule.passage_group",
       "rule.factor",
       "rule.discount",
       "rule.minimum",
       "rule.cap"
      ]
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "id",
    "scheme",
    "publisher",
    "valid_from",
    "currency",
    "timezone",
    "license",
    "method",
    "required_features"
   ]
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "legal_act": {
      "type": "string"
     },
     "retrieved": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "locator": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "id",
     "title",
     "url"
    ]
   }
  },
  "tax": {
   "type": "object",
   "properties": {
    "basis": {
     "enum": [
      "included",
      "excluded",
      "not_applicable",
      "unknown"
     ]
    },
    "rate": {
     "type": "string",
     "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "name": {
     "type": "string"
    },
    "note": {
     "type": "string"
    }
   },
   "additionalProperties": false,
   "required": [
    "basis"
   ]
  },
  "liable_vehicles": {
   "type": "object",
   "properties": {
    "description": {
     "type": "string"
    },
    "criteria": {
     "$ref": "#/$defs/criteria"
    }
   },
   "additionalProperties": false,
   "required": [
    "criteria"
   ]
  },
  "vehicle_class_sets": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
     },
     "name": {
      "type": "string"
     },
     "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string",
         "minLength": 1,
         "pattern": "^\\S(.*\\S)?$"
        },
        "label": {
         "type": "string"
        },
        "criteria": {
         "$ref": "#/$defs/criteria"
        },
        "fallback": {
         "type": "string",
         "minLength": 1,
         "pattern": "^\\S(.*\\S)?$"
        }
       },
       "additionalProperties": false,
       "required": [
        "id",
        "criteria"
       ]
      }
     }
    },
    "additionalProperties": false,
    "required": [
     "id",
     "classes"
    ]
   }
  },
  "time_classes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
     },
     "label": {
      "type": "string"
     },
     "days": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "properties": {
        "weekdays": {
         "type": "array",
         "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
         }
        },
        "months": {
         "type": "array",
         "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
         }
        },
        "dates": {
         "type": "array",
         "items": {
          "type": "string",
          "pattern": "^(\\d{4}-)?\\d{2}-\\d{2}$"
         }
        },
        "date_ranges": {
         "type": "array",
         "items": {
          "type": "array",
          "items": {
           "type": "string",
           "pattern": "^(\\d{4}-)?\\d{2}-\\d{2}$"
          },
          "minItems": 2,
          "maxItems": 2
         }
        },
        "easter": {
         "type": "array",
         "items": {
          "type": "array",
          "items": {
           "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
         }
        },
        "calendars": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(.*\\S)?$"
         }
        },
        "exclude": {
         "type": "object",
         "properties": {
          "weekdays": {
           "type": "array",
           "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
           }
          },
          "months": {
           "type": "array",
           "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
           }
          },
          "dates": {
           "type": "array",
           "items": {
            "type": "string",
            "pattern": "^(\\d{4}-)?\\d{2}-\\d{2}$"
           }
          },
          "date_ranges": {
           "type": "array",
           "items": {
            "type": "array",
            "items": {
             "type": "string",
             "pattern": "^(\\d{4}-)?\\d{2}-\\d{2}$"
            },
            "minItems": 2,
            "maxItems": 2
           }
          },
          "easter": {
           "type": "array",
           "items": {
            "type": "array",
            "items": {
             "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
           }
          },
          "calendars": {
           "type": "array",
           "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(.*\\S)?$"
           }
          }
         },
         "additionalProperties": false
        }
       },
       "additionalProperties": false
      }
     },
     "times": {
      "type": "array",
      "items": {
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^24:00$"
       },
       "minItems": 2,
       "maxItems": 2
      }
     },
     "defined": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "id"
    ]
   }
  },
  "calendars": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
     },
     "name": {
      "type": "string"
     },
     "dates": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
     },
     "covers_to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     }
    },
    "additionalProperties": false,
    "required": [
     "id",
     "dates",
     "covers_to"
    ]
   }
  },
  "user_classes": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
     },
     "label": {
      "type": "string"
     },
     "payment": {
      "type": "array",
      "items": {
       "enum": [
        "electronic",
        "account",
        "card",
        "cash"
       ]
      }
     },
     "note": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "id"
    ]
   }
  },
  "charge_objects": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
     },
     "type": {
      "enum": [
       "network",
       "section",
       "station",
       "point",
       "area",
       "jurisdiction"
      ]
     },
     "parents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "type": "string",
       "minLength": 1,
       "pattern": "^\\S(.*\\S)?$"
      }
     },
     "name": {
      "type": "string"
     },
     "names": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "code": {
      "type": "string"
     },
     "operator": {
      "type": "string"
     },
     "road": {
      "type": "string"
     },
     "network": {
      "type": "object",
      "properties": {
       "road_types": {
        "type": "array",
        "items": {
         "enum": [
          "motorway",
          "trunk",
          "other"
         ]
        }
       },
       "area": {
        "enum": [
         "suburban",
         "interurban"
        ]
       },
       "description": {
        "type": "string"
       }
      },
      "additionalProperties": false
     },
     "from": {
      "$ref": "#/$defs/place"
     },
     "to": {
      "$ref": "#/$defs/place"
     },
     "length_km": {
      "type": "number"
     },
     "location": {
      "type": "object",
      "properties": {
       "geometry": {
        "$ref": "#/$defs/geometry"
       },
       "openlr": {
        "type": "string"
       },
       "osm": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "heading": {
        "type": "number"
       },
       "match_m": {
        "type": "number"
       },
       "headings": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "point_names": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      },
      "additionalProperties": false
     },
     "jurisdiction": {
      "type": "object",
      "properties": {
       "country": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
       },
       "region": {
        "type": "string",
        "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
       }
      },
      "additionalProperties": false,
      "required": [
       "country"
      ]
     },
     "note": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "id",
     "type"
    ]
   }
  },
  "charges": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/charge"
   }
  },
  "rules": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
     },
     "kind": {
      "enum": [
       "exemption",
       "included_in",
       "passage_group",
       "factor",
       "discount",
       "minimum",
       "cap"
      ]
     },
     "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 1,
       "pattern": "^\\S(.*\\S)?$"
      }
     },
     "params": {
      "type": "object"
     }
    },
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "applies_to",
     "params"
    ],
    "allOf": [
     {
      "if": {
       "properties": {
        "kind": {
         "const": "exemption"
        }
       }
      },
      "then": {
       "properties": {
        "params": {
         "type": "object",
         "properties": {
          "criteria": {
           "$ref": "#/$defs/criteria"
          },
          "user_class": {
           "type": "string",
           "minLength": 1,
           "pattern": "^\\S(.*\\S)?$"
          },
          "from": {
           "type": "string",
           "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "until": {
           "type": "string",
           "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "note": {
           "type": "string"
          }
         },
         "additionalProperties": false,
         "anyOf": [
          {
           "required": [
            "criteria"
           ]
          },
          {
           "required": [
            "user_class"
           ]
          }
         ]
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "kind": {
         "const": "included_in"
        }
       }
      },
      "then": {
       "properties": {
        "params": {
         "type": "object",
         "properties": {
          "charge": {
           "type": "string",
           "minLength": 1,
           "pattern": "^\\S(.*\\S)?$"
          },
          "objects": {
           "type": "array",
           "minItems": 1,
           "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(.*\\S)?$"
           }
          },
          "note": {
           "type": "string"
          }
         },
         "additionalProperties": false,
         "required": [
          "charge"
         ]
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "kind": {
         "const": "passage_group"
        }
       }
      },
      "then": {
       "properties": {
        "params": {
         "type": "object",
         "properties": {
          "objects": {
           "type": "array",
           "minItems": 1,
           "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(.*\\S)?$"
           }
          },
          "minutes": {
           "type": "integer",
           "minimum": 1
          },
          "pays": {
           "enum": [
            "first",
            "highest"
           ]
          },
          "note": {
           "type": "string"
          }
         },
         "additionalProperties": false,
         "required": [
          "objects",
          "minutes",
          "pays"
         ]
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "kind": {
         "const": "factor"
        }
       }
      },
      "then": {
       "properties": {
        "params": {
         "type": "object",
         "properties": {
          "object": {
           "type": "string",
           "minLength": 1,
           "pattern": "^\\S(.*\\S)?$"
          },
          "factor": {
           "type": "string",
           "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "note": {
           "type": "string"
          }
         },
         "additionalProperties": false,
         "required": [
          "object",
          "factor"
         ]
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "kind": {
         "const": "discount"
        }
       }
      },
      "then": {
       "properties": {
        "params": {
         "type": "object",
         "properties": {
          "name": {
           "type": "string"
          },
          "percent": {
           "type": "string",
           "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "criteria": {
           "$ref": "#/$defs/criteria"
          },
          "user_class": {
           "type": "string",
           "minLength": 1,
           "pattern": "^\\S(.*\\S)?$"
          },
          "payment": {
           "type": "array",
           "minItems": 1,
           "items": {
            "enum": [
             "electronic",
             "account",
             "card",
             "cash"
            ]
           }
          },
          "note": {
           "type": "string"
          }
         },
         "additionalProperties": false,
         "required": [
          "name",
          "percent"
         ]
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "kind": {
         "const": "minimum"
        }
       }
      },
      "then": {
       "properties": {
        "params": {
         "type": "object",
         "properties": {
          "per": {
           "enum": [
            "usage"
           ]
          },
          "amount": {
           "type": "string",
           "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "note": {
           "type": "string"
          }
         },
         "additionalProperties": false,
         "required": [
          "per",
          "amount"
         ]
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "kind": {
         "const": "cap"
        }
       }
      },
      "then": {
       "properties": {
        "params": {
         "type": "object",
         "properties": {
          "per": {
           "enum": [
            "day",
            "month",
            "usage"
           ]
          },
          "amount": {
           "type": "string",
           "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "time_class": {
           "type": "string",
           "minLength": 1,
           "pattern": "^\\S(.*\\S)?$"
          },
          "note": {
           "type": "string"
          }
         },
         "additionalProperties": false,
         "required": [
          "per",
          "amount"
         ]
        }
       }
      }
     }
    ]
   }
  },
  "coverage": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "properties": {
     "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
     },
     "status": {
      "enum": [
       "complete",
       "partial",
       "unpriced"
      ]
     },
     "reason": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "scope",
     "status"
    ]
   }
  },
  "extensions": {
   "type": "object",
   "propertyNames": {
