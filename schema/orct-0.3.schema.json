   },
   "additionalProperties": false,
   "required": [
    "id",
    "type",
    "component",
    "unit",
    "columns",
    "rows",
    "sources",
    "basis"
   ],
   "allOf": [
    {
     "if": {
      "properties": {
       "columns": {
        "contains": {
         "const": "volume"
        }
       }
      },
      "required": [
       "columns"
      ]
     },
     "then": {
      "required": [
       "volume"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "distance"
       }
      }
     },
     "then": {
      "properties": {
       "unit": {
        "enum": [
         "km",
         "tkm"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "section"
       }
      }
     },
     "then": {
      "properties": {
       "unit": {
        "enum": [
         "use",
         "km"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "od"
       }
      }
     },
     "then": {
      "properties": {
       "unit": {
        "const": "trip"
       },
       "columns": {
        "allOf": [
         {
          "contains": {
           "const": "entry"
          }
         },
         {
          "contains": {
           "const": "exit"
          }
         }
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "point"
       }
      }
     },
     "then": {
      "properties": {
       "unit": {
        "const": "passage"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "area"
       }
      }
     },
     "then": {
      "properties": {
       "unit": {
        "enum": [
         "day",
         "entry"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "period"
       }
      }
     },
     "then": {
      "properties": {
       "unit": {
        "const": "product"
       },
       "columns": {
        "contains": {
         "const": "product"
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "quantity"
       }
      }
     },
     "then": {
      "properties": {
       "unit": {
        "enum": [
         "t_co2",
         "litre",
         "kg",
         "kwh"
        ]
       }
      }
     }
    }
